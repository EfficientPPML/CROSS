+def _owned_directory(fd):
+    """Resolve an owned directory FD by bounded lstat metadata, never /proc."""
+    if type(fd)is not int or fd<0:raise PermissionError('original owned directory FD required')
+    held=_ORIGINAL_FSTAT(fd)
