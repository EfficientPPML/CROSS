+def open_owned_directory(path):
+    """Pin the just-created directory inode until cleanup completes.
+
+    This detects path replacement and prevents inode reuse. It is not an OS
+    sandbox against a same-user child moving other entries into its own tree.
+    """
+    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        status = os.fstat(descriptor)
+        return descriptor, {'device': status.st_dev, 'inode': status.st_ino}
+    except BaseException as error:
+        try:
+            os.close(descriptor)
+        except BaseException as cleanup_error:
+            error.add_note(f'Directory handle cleanup also failed: {cleanup_error}')
+        raise
