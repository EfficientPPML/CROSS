+    # object from borrowing tables under a stale type/moduli-only identity.
+    import math
+    s = tuple(2 * math.ceil(math.log2(q)) for q in moduli)
+    w = tuple(min(x, 32) for x in s)
+    sw = tuple(a - b for a, b in zip(s, w))
