+def _scale_centered_crt_coefficient(value: int, scale: float, scale_inv: float) -> float:
+  """Scale a centered CRT integer without overflowing its initial conversion.
+
+  Preserve the existing binary64 operations when integer conversion succeeds.
+  Only an overflowing integer conversion takes the exact binary64 scale's
+  integer-ratio path. A nonrepresentable scaled result still raises; the decode
+  approximation check is unchanged.
+  """
+  try:
+    raw = float(value)
+  except OverflowError:
+    numerator, denominator = float(scale).as_integer_ratio()
+    try:
+      return (value * denominator) / numerator
+    except OverflowError as error:
+      raise OverflowError(
+          'CKKS unit-scale coefficient is not representable as binary64'
+      ) from error
+  return raw * scale_inv
+
