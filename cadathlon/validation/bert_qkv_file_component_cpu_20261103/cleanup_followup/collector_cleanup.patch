+@pytest.mark.parametrize('mode',['missing','corrupt','nonobject','unreaped'])
+def test_collector_unknown_active_process_retains_owned_files(tmp_path,monkeypatch,mode):
+ from types import SimpleNamespace
+ import collect,shutil
+ def case(command,directory,**kwargs):
+  if mode=='corrupt':(directory/'process.json').write_text('{')
+  if mode=='nonobject':(directory/'process.json').write_text('[]')
+  if mode=='unreaped':collect.process.write_json(directory/'process.json',{'process_reaped':False})
+  raise KeyboardInterrupt('primary cancellation')
+ monkeypatch.setattr(collect.process,'run_case',case)
+ args=SimpleNamespace(output=tmp_path/'evidence',snapshot=tmp_path/'unused',preprocess_python=Path(sys.executable))
+ with pytest.raises(KeyboardInterrupt,match='primary cancellation'):collect.run(args)
+ r=json.loads((args.output/'report.json').read_text());owned=Path(r['owned_component_directory'])
+ try:
+  assert r['passed'] is False and r['all_processes_reaped'] is False and r['owned_component_directory_removed'] is False
+  assert r['owned_directory_handle_closed'] is True and owned.is_dir()
+  assert r['stages']['client-preprocess']['process_reaped'] is False
+ finally:shutil.rmtree(owned) # No real child was launched by this test double.
