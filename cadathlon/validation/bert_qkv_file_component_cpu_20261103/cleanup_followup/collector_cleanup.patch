+  r=json.loads((directory.parent/'report.json').read_text());owned=Path(r['owned_component_directory']);other=owned.with_name(owned.name+'-moved');owned.rename(other);moved.extend([owned,other]);owned.mkdir();(owned/'sentinel').write_text('keep')
