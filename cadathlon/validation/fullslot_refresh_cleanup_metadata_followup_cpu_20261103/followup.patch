+@pytest.mark.parametrize('mode',('healthy','primary-and-cleanup-failure','cleanup-only-cancellation'))
+def test_cleanup_completion_metadata_matches_attempted_releases(monkeypatch,mode):
+    import jax
+    from jaxite_word import ckks_ctx
+    events=[];primary=KeyboardInterrupt('original cancellation') if mode=='primary-and-cleanup-failure' else None
+    def close_owner():
+        events.append('owner')
+        if mode=='primary-and-cleanup-failure':raise RuntimeError('owner release failed')
+        if mode=='cleanup-only-cancellation':raise KeyboardInterrupt('cleanup cancellation')
+    monkeypatch.setattr(ckks_ctx,'evict_context_caches',lambda context:events.append('context'))
+    monkeypatch.setattr(jax,'clear_caches',lambda:events.append('jax'))
+    monkeypatch.setattr(proof.gc,'collect',lambda:events.append('gc'))
+    owner=types.SimpleNamespace(close=close_owner);keys=types.SimpleNamespace(close=lambda:events.append('keys'))
+    report={}
+    if mode=='cleanup-only-cancellation':
+        with pytest.raises(KeyboardInterrupt,match='cleanup cancellation'):
+            proof.record_cleanup(report,[object()],owner,keys,primary)
+        assert report['cleanup_completed'] is False
+    else:
+        proof.record_cleanup(report,[object()],owner,keys,primary)
+        assert report['cleanup_completed'] is (mode=='healthy')
+        assert bool(report['cleanup_errors']) is (mode!='healthy')
+        if primary is not None:assert any('owner release failed' in note for note in primary.__notes__)
+    assert events==['owner','context','jax','gc','keys']
