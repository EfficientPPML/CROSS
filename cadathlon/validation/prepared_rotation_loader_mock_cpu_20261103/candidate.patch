+    def check(self):
+        if (self.owner.ctx is not self.context or self.owner.rotation is not self.rotation
+                or _method_identity(self.owner._clear_working_caches)!=_method_identity(self.clear)
+                or _method_identity(self.rotation.clear)!=_method_identity(self.rotation_clear)
+                or _method_identity(self.rotation.close)!=_method_identity(self.rotation_close)):
+            raise ValueError('registered prepared owner or cleanup callable replaced')
+        return True
+
