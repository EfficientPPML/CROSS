+        inverse = self.arithmetic.evaluate(denominator, approximations['reciprocal'], output_weights=active/counts)
+        del denominator
+        probabilities = self.arithmetic.multiply(exponentials, inverse)
+        del exponentials, inverse
+        if positive:
