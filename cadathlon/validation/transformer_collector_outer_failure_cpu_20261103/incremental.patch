+@pytest.mark.parametrize('stage', ['implementation', 'software', 'initial_publication'])
+def test_prelaunch_failure_keeps_concrete_failed_metadata(monkeypatch, tmp_path, stage):
+    args = prepare_evaluation(monkeypatch, tmp_path)
+    if stage == 'implementation':
+        args.implementation.unlink()
+        error_type = FileNotFoundError
+    elif stage == 'software':
+        def fail():
+            raise RuntimeError('package metadata unavailable')
+        monkeypatch.setattr(suite, 'software_versions', fail)
+        error_type = RuntimeError
+    else:
+        real_write = suite.write_json
+        calls = 0
+        def write(path, value):
+            nonlocal calls
+            calls += 1
+            if calls == 1:
+                raise OSError('initial write interrupted')
+            return real_write(path, value)
+        monkeypatch.setattr(suite, 'write_json', write)
+        error_type = OSError
+    def no_launch(*args, **kwargs):
+        pytest.fail('prelaunch metadata failure must not launch a child')
+    monkeypatch.setattr(suite, 'run_case', no_launch)
+    with pytest.raises(error_type):
+        suite.evaluate(args)
+    report = json.loads((args.output / 'report.json').read_text())
+    assert report['passed'] is False and report['cases'] == {} and report['error']
+    assert report['implementation_requested'] == str(args.implementation)
+    if stage == 'software':
+        assert report['source_hashes_start'] == report['source_hashes_end'] == {'source.py': 'unchanged'}
+        assert report['source_files_unchanged'] is True
+
