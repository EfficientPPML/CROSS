+@pytest.mark.parametrize('error_type', [KeyboardInterrupt, SystemExit, RuntimeError])
+def test_final_sweep_publication_preserves_primary_error(monkeypatch, tmp_path, error_type):
+    args = prepare_evaluation(monkeypatch, tmp_path)
+    primary = error_type('primary child failure')
+    def fail_child(*args, **kwargs):
+        raise primary
+    real_write = suite.write_json
+    def fail_final_write(path, value):
+        if 'elapsed_s' in value:
+            raise OSError('final report publication failed')
+        return real_write(path, value)
+    monkeypatch.setattr(suite, 'run_case', fail_child)
+    monkeypatch.setattr(suite, 'write_json', fail_final_write)
+    with pytest.raises(error_type) as observed:
+        suite.evaluate(args)
+    assert observed.value is primary
+    assert any('Final sweep evidence write failed: OSError' in note for note in primary.__notes__)
+    # The last successfully written record remains explicitly incomplete.
+    report = json.loads((args.output / 'report.json').read_text())
+    assert report['passed'] is False and report['complete'] is False
+
+
+def test_final_publication_failure_prevents_success_return(monkeypatch, tmp_path):
+    args = prepare_evaluation(monkeypatch, tmp_path)
+    real_write = suite.write_json
+    def fail_final_write(path, value):
+        if 'elapsed_s' in value:
+            raise OSError('cannot publish final success')
+        return real_write(path, value)
+    monkeypatch.setattr(suite, 'write_json', fail_final_write)
+    with pytest.raises(OSError, match='cannot publish final success'):
+        suite.evaluate(args)
+    report = json.loads((args.output / 'report.json').read_text())
+    assert len(report['cases']) == 5 and report['passed'] is False
+    # The last case has its own completed record; the sweep snapshot was
+    # written before it started, and final publication never succeeded.
+    assert json.loads((args.output / 'test6/process.json').read_text())['passed'] is True
+    assert report['complete'] is False and report['scoring_calibrated'] is False
+
