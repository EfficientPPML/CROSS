+@pytest.mark.parametrize('error_type', [FileNotFoundError, KeyboardInterrupt, SystemExit])
+def test_initial_source_failure_records_failed_attempt_without_launch(monkeypatch, tmp_path, error_type):
+    primary = error_type('initial source inspection failed')
+    def fail_sources(*args):
+        raise primary
+    args = prepare_evaluation(monkeypatch, tmp_path, sources=fail_sources)
+    def no_launch(*args, **kwargs):
+        pytest.fail('a source-inspection failure must not launch a child')
+    monkeypatch.setattr(suite, 'run_case', no_launch)
+    with pytest.raises(error_type) as observed:
+        suite.evaluate(args)
+    assert observed.value is primary
+    report = json.loads((args.output / 'report.json').read_text())
+    assert report['passed'] is False and report['complete'] is False
+    assert report['all_six_passed'] is False and report['scoring_calibrated'] is False
+    assert report['source_hashes_start'] is None and report['source_hashes_end'] is None
+    assert report['source_files_unchanged'] is False and report['cases'] == {}
+    assert 'initial source inspection failed' in report['error']
+
