+@pytest.mark.parametrize('publication_failure', [False, True])
+def test_final_source_cancellation_is_preserved_after_publication(monkeypatch, tmp_path, publication_failure):
+    calls = 0
+    cancellation = KeyboardInterrupt('cancelled final source inspection')
+    def sources(*args):
+        nonlocal calls
+        calls += 1
+        if calls == 8:  # initial + six completed cases, then final inspection
+            raise cancellation
+        return {'source.py': 'unchanged'}
+    args = prepare_evaluation(monkeypatch, tmp_path, sources=sources)
+    real_write = suite.write_json
+    def write(path, value):
+        if publication_failure and 'elapsed_s' in value:
+            raise OSError('secondary final publication failure')
+        return real_write(path, value)
+    monkeypatch.setattr(suite, 'write_json', write)
+    with pytest.raises(KeyboardInterrupt) as observed:
+        suite.evaluate(args)
+    assert observed.value is cancellation
+    report = json.loads((args.output / 'report.json').read_text())
+    assert report['passed'] is False
+    if publication_failure:
+        assert any('Final sweep evidence write failed' in note for note in cancellation.__notes__)
+    else:
+        assert report['source_files_unchanged'] is False
+        assert report['source_hashes_end'] is None
+        assert 'cancelled final source inspection' in report['error']
