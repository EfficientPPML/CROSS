+"""Optional rescale-facade NTT reuse: exact controls, arithmetic and ownership."""
+from pathlib import Path
+import gc,sys,weakref
+import numpy as np
+import pytest
+ROOT=Path(__file__).resolve().parents[2]
+sys.path[:0]=[str(ROOT),str(ROOT/'cadathlon/common')]
+import jax
+from jaxite_word import he_params,ckks_ctx
+import finite_field,polynomial,rescale
+from encrypted_ntt import FIELDS,ScopedNTTSubsets,enable_scoped_ntt_subsets
+from encrypted_primitives import CompiledRescale
+from encrypted_polynomial import EncryptedPolynomialEvaluator
+from encrypted_refresh import _install_compiled_primitives
+from test_scoped_ntt import make_owner
+from test_encrypted_tensor_only import ring,server_for,bootstrap_shell,assert_same
+jax.config.update('jax_enable_x64',True)
+RECORDS=[]
+
+def controls_equal(actual,expected):
+ assert actual.moduli==expected.moduli and actual.output_moduli==expected.output_moduli
+ assert actual.composite_degree==expected.composite_degree
+ assert actual._lift_reduction_modes==expected._lift_reduction_modes
+ for name in ('moduli_threshold_all','gammas_stacked','betas_stacked','lift_add_stacked'):
+  np.testing.assert_array_equal(getattr(actual,name),getattr(expected,name))
+ count=0
+ for a,b in zip(actual.ct_last_list+actual.ct_work_list,expected.ct_last_list+expected.ct_work_list):
+  assert a.moduli==b.moduli and a.shape==b.shape
+  for name in FIELDS:
+   np.testing.assert_array_equal(getattr(a.ntt_ctx,name),getattr(b.ntt_ctx,name));count+=1
+ return count
+
+@pytest.mark.parametrize('drop',[1,2,3])
+@pytest.mark.parametrize('elements',[2,3])
+def test_all_rescale_prefix_and_singleton_tables_exact(drop,elements):
+ owner=make_owner();provider=ScopedNTTSubsets(owner)
+ args=dict(batch=2,num_elements=elements,moduli=owner.q_towers,r=16,c=16,degree_layout=(16,16))
+ expected=rescale._HERescaleKernel(**args);actual=rescale._HERescaleKernel(**args,polynomial_factory=provider.polynomial_factory)
+ for kernel in (expected,actual):kernel.control_gen(composite_degree=drop)
+ checks=controls_equal(actual,expected);assert checks==12*drop
+ shape=dict(batch=2,num_elements=elements,degree=256,precision=32,num_moduli=4,degree_layout=(16,16))
+ data=np.random.default_rng(1500+drop+elements).integers(0,2**31,size=(2,elements,16,16,4),dtype='uint32')
+ data=data%np.asarray(owner.q_towers,dtype='uint32')
+ value=polynomial.Polynomial(shape,{'moduli':owner.q_towers},payload=jax.numpy.asarray(data))
+ value._ckks_scale=2.**80;value._ckks_nsd=3
+ assert_same(actual.rescale(value),expected.rescale(value))
+ provider.close();assert controls_equal(actual,expected)==checks
+ RECORDS.append(dict(kind='public_controls_and_raw_arithmetic',drop=drop,elements=elements,six_field_checks=checks,stats=dict(provider.stats)))
+
+
+def test_nonstandard_reduction_keeps_original_constructor():
+ owner=make_owner();provider=ScopedNTTSubsets(owner)
+ args=dict(batch=1,num_elements=2,moduli=owner.q_towers,r=16,c=16,finite_field_context=finite_field.MontgomeryContext)
+ expected=rescale._HERescaleKernel(**args);actual=rescale._HERescaleKernel(**args,polynomial_factory=provider.polynomial_factory)
+ for kernel in (expected,actual):kernel.control_gen(composite_degree=2)
+ assert controls_equal(actual,expected)==24
+ assert provider.stats['builds']==0
+ for value in actual.ct_last_list+actual.ct_work_list:assert value.ntt_ctx.ff_ctx.computation_format_is_standard is False
+
+
+def test_rescale_owner_slot_is_atomic_and_close_preserves_replacement(ring):
+ server=server_for(ring,1);cache=server._param_cache;occupied=lambda *a:None
+ cache.rescale_polynomial_factory=occupied
+ with pytest.raises(ValueError,match='already owns'):enable_scoped_ntt_subsets(server)
+ assert cache.rotation_polynomial_factory is None and cache.multiplication_polynomial_factory is None
+ cache.rescale_polynomial_factory=None;provider=enable_scoped_ntt_subsets(server)
+ assert cache.rescale_polynomial_factory.__self__ is provider
+ cache.rescale_polynomial_factory=occupied;provider.close();provider.close()
+ assert cache.rescale_polynomial_factory is occupied
+ assert cache.rotation_polynomial_factory is None and cache.multiplication_polynomial_factory is None
+ cache.rescale_polynomial_factory=None;ckks_ctx.evict_context_caches(server)
+
