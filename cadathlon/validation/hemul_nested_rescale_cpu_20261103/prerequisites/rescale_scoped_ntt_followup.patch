+def test_secure_facade_compiled_bootstrap_dispatch_and_lifetime(ring):
+ client=ring[0]
+ def execute():
+  ordinary=server_for(ring,2);server=server_for(ring,2)
+  assert server.secret_key is None and server._param_cache.secret_key is None and server.parameters.get('secret_key') is None
+  def forbidden(*a,**kw):raise AssertionError('no server encryption/decryption')
+  for name in ('encrypt','decrypt','encrypt_slots','decrypt_slots','encrypt_slots_batch','decrypt_slots_batch'):setattr(server,name,forbidden)
+  provider=enable_scoped_ntt_subsets(server)
+  helper=CompiledRescale(server);evaluator=EncryptedPolynomialEvaluator(server)
+  values=np.stack([np.linspace(-.3,.3,client.num_slots),.2*np.sin(np.arange(client.num_slots)/17)])
+  fresh=client.encrypt_slots_batch(values,scale=float(1<<40))
+  pt=server.encode_at_level(np.full(client.num_slots,.5),2,scale=float(1<<40))
+  twice=server.ptct_mul[2].mul(fresh,pt)
+  thrice=server.ptct_mul[2].mul(twice,pt)
+  snapshots=[(v,v.polynomial,v._ckks_scale,getattr(v,"_ckks_nsd",None),v.moduli[:]) for v in (fresh,twice,thrice)]
+  eager=bootstrap_shell(ordinary);compiled=bootstrap_shell(server);helpers=_install_compiled_primitives(compiled,server)
+  for source,target,value,truth in [(2,1,twice,.5*values),(1,0,server.he_level_reduce[2,1].level_reduce(twice),.5*values),(2,0,thrice,.25*values)]:
+   expected_op=ordinary.he_rescale[source,target];actual_op=server.he_rescale[source,target]
+   assert expected_op._he_rescale._polynomial_factory is rescale.Polynomial
+   assert actual_op._he_rescale._polynomial_factory.__self__ is provider
+   checks=controls_equal(actual_op._he_rescale,expected_op._he_rescale)
+   expected=expected_op.rescale(value);actual=actual_op.rescale(value);assert_same(actual,expected)
+   error=float(np.max(np.abs(client.decrypt_slots_batch(actual)-truth)));assert error<5e-6,error
+   assert_same(helper.rescale(value,source,target),expected)
+   count=helper.compiler.compile_count
+   helper.clear();server.he_rescale._instances.clear();provider.clear();jax.clear_caches()
+   assert_same(helper.rescale(value,source,target),expected);assert helper.compiler.compile_count==count
+   for decrement in (False,True):
+    assert_same(compiled._he_op_rescale(source,target,value,decrement_nsd=decrement),
+                eager._he_op_rescale(source,target,value,decrement_nsd=decrement))
+   RECORDS.append(dict(kind='secure_rescale_paths',source=source,target=target,input_nsd=value._ckks_nsd,six_field_checks=checks,max_abs_error=error,raw_payload_and_metadata_exact=True,executable_reused=True))
+  for v,payload,scale,nsd,moduli in snapshots:
+   assert v.polynomial is payload and v._ckks_scale==scale and getattr(v,"_ckks_nsd",None)==nsd and v.moduli==moduli
+  compiler=helper.compiler;control_refs=[weakref.ref(x) for x in helper.binding[1].controls]
+  owner_refs=[weakref.ref(server),weakref.ref(server._param_cache)]
+  for h in helpers:h.clear()
+  helper.clear();provider.close();server.he_rescale._instances.clear()
+  assert server._param_cache.rescale_polynomial_factory is None
+  assert server.he_rescale[1,0]._he_rescale._polynomial_factory is rescale.Polynomial
+  ckks_ctx.evict_context_caches(server);ckks_ctx.evict_context_caches(ordinary)
+  return compiler,control_refs,owner_refs,provider
+ compiler,controls,owners,provider=execute()
+ jax.clear_caches();polynomial._POLYNOMIAL_REGISTRY.clear();he_params.ntt_mm._barrett_ntt_context_cache.clear();gc.collect()
+ assert all(r() is None for r in controls)
+ assert all(r() is None for r in owners)
+ assert compiler._executables and provider.live_entries==0
+ RECORDS.append(dict(kind='lifetime',retired_controls_collected=True,retired_owners_collected=True,executable_cache_retained=True))
