 class BootstrappingTest(absltest.TestCase):
 
+  def test_noisy_signed_input_independent_output_key_two_aux_primes(self):
+    degree = 16
+    q_limbs = TEST_PRIMES[:2]
+    p_limbs = TEST_PRIMES[2:4]
+    scale = float(q_limbs[-1])
+    source = random.TestRandomSource(2026)
+    # The last baby-step group is partial: ceil(8 / 3) needs two mux bits.
+    input_coeffs = np.zeros((degree, 1), dtype=np.uint64)
+    input_coeffs[7, 0] = q_limbs[0] - 1
+    input_sk = types.SecretKey(
+        ntt_cpu.ntt_negacyclic_poly(input_coeffs, q_limbs[:1]),
+        np.array(q_limbs[:1], dtype=np.uint32),
+    )
+    output_coeffs = np.resize(np.array([-1, 0, 1]), degree)
+    output_residues = np.column_stack([
+        output_coeffs % q for q in q_limbs
+    ]).astype(np.uint64)
+    output_sk = types.SecretKey(
+        ntt_cpu.ntt_negacyclic_poly(output_residues, q_limbs),
+        np.array(q_limbs, dtype=np.uint32),
+    )
+    pk, _ = key_gen.keygen(
+        degree, q_limbs[:1], random_source=source, sk=input_sk
+    )
+    ship = bootstrapping.SHIP()
+    ship.precompute_constants(
+        q_limbs, p_limbs, degree, 1, input_sk, 3, source,
+        output_sk=output_sk,
+    )
+    self.assertFalse(hasattr(ship, "nonzero_idx"))
+    # Ensure a pytree round-trip does not reintroduce the private support.
+    leaves, structure = jax.tree.flatten(ship)
+    restored = jax.tree.unflatten(structure, leaves)
+    self.assertFalse(hasattr(restored, "nonzero_idx"))
+    mu = np.linspace(-0.1, 0.1, degree // 2)
+    pt = encode_coeffs(mu, degree, q_limbs[0], q_limbs[:1])
+    ct = encrypt.Encrypt(pk).encrypt(pt, random_source=source)
+    out = jax.jit(lambda k, c: k.half_bootstrap(c, 3, scale))(restored, ct)
+    self.assertEqual(out.data.shape, (2, degree, 1))
+    self.assertEqual(out.data.dtype, jax.numpy.uint32)
+    decoded = encode.Decode(scale, degree // 2).decode(
+        encrypt.Decrypt(output_sk).decrypt(out)
+    )
+    expected = np.sin(2 * np.pi * mu) / (2 * np.pi)
+    np.testing.assert_allclose(decoded, expected, atol=1e-4, rtol=0)
+
